# PyRetort Build Configuration

############################################################
# your project
############################################################
# Path to the root of the user's project (escaped for Windows paths)
project_dir = "{{ project_dir | replace('\\', '\\\\') }}"
# List of package requirements to include in the build
requirements = [
{%- for req in requirements %}
    "{{ req }}"{% if not loop.last %},{% endif %}
{%- endfor %}
]
# Subdirectory inside project_dir that contains the source package/module
project_source_subdir = "{{ project_source_subdir | replace('\\', '\\\\') }}"
# The entry-point file to run (e.g., main.py)
main_file = "{{ main_file }}"
# Whether to run the project with -m (treat as package)
run_as_package = {{ run_as_package | lower }}

############################################################
# Embedded python interpreter
############################################################
# Target Python version to embed in the build (e.g., 3.11.4)
python_version = "{{ python_version }}"
# Optional Python architecture (AMD64, ARM64, x86). Empty = autodetect
python_architecture = "{{ python_architecture | default('') }}"

############################################################
# Build directories
############################################################
# Directory where Python distribution files will be placed
pydist_dir = "{{ pydist_dir | replace('\\', '\\\\') }}"
# Directory containing temporary build source files
build_source_dir = "{{ build_source_dir | replace('\\', '\\\\') }}"

############################################################
# Output files
############################################################
# Name of the generated executable (without path)
exe_file_name = "{{ exe_file_name }}"
{% if icon_path -%}
# Path to the icon file used for the executable (Windows .ico)
icon_path = "{{ icon_path | replace('\\', '\\\\') }}"
{% else -%}
# icon_path = ""
{% endif -%}
# Whether the console window is shown when running the exe (true/false)
show_console = {{ show_console | lower }}
# Name of the final distribution ZIP archive, uncomment to be created
# dist_zip_file_name = "{{ dist_zip_file_name }}"

############################################################
# Cache and build output directories
############################################################
# Directory used to cache downloaded dependencies
download_cache_dir = "{{ download_cache_dir | replace('\\', '\\\\') }}"
# Directory for intermediate build outputs
build_output_dir = "{{ build_output_dir | replace('\\', '\\\\') }}"
# Directory where final distribution artifacts are written
dist_output_dir = "{{ dist_output_dir | replace('\\', '\\\\') }}"
